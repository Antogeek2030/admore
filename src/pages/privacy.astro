---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Privacy Policy | AC Repair Ardmore OK" description="Privacy policy for acrepairardmorepa.com.">
  <section class="page-hero">
    <div class="container">
      <h1>Privacy Policy</h1>
      <p>How we handle information on this website.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <p>This website is provided for informational purposes about AC repair services in Ardmore, OK. We do not collect personal information through forms on this site unless you choose to contact us by phone.</p>
      <h2>Phone Contact</h2>
      <p>When you call us, we use the information you provide only to schedule service and communicate about your repair needs.</p>
      <h2>Analytics</h2>
      <p>This site may use basic server logs or privacy-respecting analytics. No personal advertising profiles are created.</p>
      <h2>Third Parties</h2>
      <p>We do not sell or share your contact information with third parties for marketing.</p>
      <h2>Contact</h2>
      <p>Questions about this policy can be directed to the phone number listed on this site.</p>
    </div>
  </section>
</Layout>
