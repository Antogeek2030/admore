---
import Layout from '../../layouts/Layout.astro';
const phone = '+15805550199';
const phoneDisplay = '(580) 555-0199';
---
<Layout title="Ductless Mini-Split Repair in Ardmore, OK" description="Ductless mini-split repair and service in Ardmore, OK. Mitsubishi, Fujitsu, Daikin, and more.">
  <section class="page-hero">
    <div class="container">
      <h1>Ductless Mini-Split Repair</h1>
      <p>Specialized service for single and multi-zone ductless systems.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <p>Ductless mini-splits need technicians who understand inverter technology, refrigerant circuits, and brand-specific error codes. We service Mitsubishi, Fujitsu, Daikin, LG, and other popular brands.</p>
      <h2>What We Handle</h2>
      <ul>
        <li>Error code diagnosis and board issues</li>
        <li>Refrigerant leaks and recharge</li>
        <li>Indoor and outdoor unit repairs</li>
        <li>Single and multi-zone systems</li>
        <li>Installation and replacement</li>
      </ul>
      <h2>Ready to Schedule?</h2>
      <p>Call <a href={`tel:${phone}`}>{phoneDisplay}</a> for ductless service in Ardmore, OK.</p>
      <p style="margin-top:1.5rem"><a href={`tel:${phone}`} class="btn btn-primary">Call Now — {phoneDisplay}</a></p>
    </div>
  </section>
</Layout>
