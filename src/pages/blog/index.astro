---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Blog | AC Repair Ardmore OK" description="Tips, guides, and advice on air conditioning repair, maintenance, and efficiency for Ardmore homeowners.">
  <section class="page-hero">
    <div class="container">
      <h1>AC Tips & Guides</h1>
      <p>Practical advice for keeping your home cool in Ardmore, OK.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-card">
            <div class="blog-card-body">
              <div class="blog-meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · {post.data.author}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span style="color:var(--primary-light);font-weight:600;font-size:0.9rem">Read more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
